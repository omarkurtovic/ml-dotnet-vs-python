@using MudBlazor
@using OmarDesignSystem
@using SharedCL
@using WebApp.LungCancerPrediction.ApiClients
@inject ISnackbar Snackbar
@inject CSharpLCApiClient CSharpLCApi

@if(Model != null)
{
    <MudStack Spacing="4" Class="pa-4">
        
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <SubHeading Class="mb-0">@Loc.T("LCInfo_Title")</SubHeading>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Color="Color.Default"
                           OnClick="@(async () => await Close.InvokeAsync())" />
        </MudStack>

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudChip T="string" Color="@(Model.Language == ModelLanguageDto.CSharp ? Color.Primary : Color.Secondary)" Size="Size.Small">
                @Model.Language
            </MudChip>
            <MudChip T="string" Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small">
                @Model.NumberOfEpochs @Loc.T("LCInfo_Epochs")
            </MudChip>
            <MudChip T="string" Icon="@Icons.Material.Filled.Memory" Size="Size.Small" Variant="Variant.Outlined">
                @Model.HardwareInfo
            </MudChip>
        </MudStack>

        <MudDivider Class="my-2" />

        <SectionHeading Class="mt-4">@Loc.T("LCInfo_PerformanceByClass")</SectionHeading>
        <MudSimpleTable Hover="true" Dense="true" Elevation="0" Style="background: transparent;">
            <thead>
                <tr>
                    <th>@Loc.T("LCInfo_ClassByClass")</th>
                    <th>@Loc.T("LCInfo_RecallByClass")</th>
                    <th>@Loc.T("LCInfo_PrecisionByClass")</th>
                    <th>@Loc.T("LCInfo_F1ScoreByClass")</th>
                </tr>
            </thead>
            <tbody>
                <tr style="background-color: var(--mud-palette-background-grey);">
                    <td><b>@Loc.T("LCInfo_MacroAverage")</b></td>
                    <td>@(FormatPercent(Model.MacroRecall))</td>
                    <td>@(FormatPercent(Model.MacroPrecision))</td>
                    <td>@(FormatPercent(Model.MacroF1Score))</td>
                </tr>
                <tr>
                    <td>@Loc.T("LCInfo_NormalClass")</td>
                    <td>@(FormatPercent(Model.NormalRecall))</td>
                    <td>@(FormatPercent(Model.NormalPrecision))</td>
                    <td>@(FormatPercent(Model.NormalF1Score))</td>
                </tr>
                <tr>
                    <td>@Loc.T("LCInfo_BenignClass")</td>
                    <td>@(FormatPercent(Model.BenignRecall))</td>
                    <td>@(FormatPercent(Model.BenignPrecision))</td>
                    <td>@(FormatPercent(Model.BenignF1Score))</td>
                </tr>
                <tr>
                    <td>@Loc.T("LCInfo_MalignantClass")</td>
                    <td>@(FormatPercent(Model.MalignantRecall))</td>
                    <td>@(FormatPercent(Model.MalignantPrecision))</td>
                    <td>@(FormatPercent(Model.MalignantF1Score))</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        <SectionHeading>@Loc.T("LCInfo_Performance")</SectionHeading>
        <MudSimpleTable Hover="true" Dense="true" Elevation="0" Style="background: transparent;">
            <thead>
                <tr>
                    <th>@Loc.T("LCInfo_Metric")</th>
                    <th>@Loc.T("LCInfo_Training")</th>
                    <th>@Loc.T("LCInfo_Validation")</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><b>@Loc.T("LCInfo_Accuracy")</b></td>
                    <td>@(FormatPercent(Model.TrainingAccuracy))</td>
                    <td>@(FormatPercent(Model.ValidationAccuracy))</td>
                </tr>
                <tr>
                    <td><b>@Loc.T("LCInfo_Loss")</b></td>
                    <td>@(FormatPercent(Model.TrainingLoss))</td>
                    <td>@(FormatPercent(Model.ValidationLoss))</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        <SectionHeading>@Loc.T("LCInfo_PerformanceTimes")</SectionHeading>
        <MudSimpleTable Hover="true" Dense="true" Elevation="0" Style="background: transparent;">
            <thead>
                <tr>
                    <th>@Loc.T("LCInfo_Step")</th>
                    <th>@Loc.T("LCInfo_TimeSeconds")</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><b>@Loc.T("LCInfo_TrainingTime")</b></td>
                    <td>@Math.Round(Model.TrainingTimeInSeconds, 2) @Loc.T("LCInfo_Seconds")</td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudStack>
}

@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public EventCallback Close { get; set; }

    public LCInfoDto? Model { get; set; }

    public async Task ShowModelDetails(int id)
    {
        if (id == 0)
        {
            await Close.InvokeAsync();
            return;
        }

        var result = await CSharpLCApi.GetModelInfoAsync(id);
        if (result.IsSuccess)
        {
            Model = result.Data;
        }
        else
        {
            Snackbar.Add(Loc.T("LCInfo_Error"), Severity.Error);
            await Close.InvokeAsync();
        }

        StateHasChanged();
    }

    private string FormatPercent(double? value)
    {
        return value.HasValue ? $"{Math.Round(value.Value * 100, 2)}%" : "-";
    }
}
