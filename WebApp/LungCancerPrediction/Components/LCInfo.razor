@using ApexCharts
@using MudBlazor
@using OmarDesignSystem
@using SharedCL
@using WebApp.LungCancerPrediction.ApiClients
@inject ISnackbar Snackbar
@inject CSharpLCApiClient CSharpLCApi
@implements IDisposable

@if(Model != null)
{
    <MudStack Spacing="4" Class="pa-4">
        
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <SubHeading Class="mb-0">@Loc.T("LCInfo_Title")</SubHeading>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Color="MudBlazor.Color.Default"
                           OnClick="@(async () => await Close.InvokeAsync())" />
        </MudStack>


        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudChip T="string" Color="@(Model.Language == ModelLanguageDto.CSharp ? MudBlazor.Color.Primary : MudBlazor.Color.Secondary)" Size="MudBlazor.Size.Small">
                @Model.Language
            </MudChip>
            <MudChip T="string" Icon="@Icons.Material.Filled.Autorenew" Size="MudBlazor.Size.Small">
                @Model.TotalEpochs @Loc.T("LCInfo_Epochs")
            </MudChip>
            <MudChip T="string" Icon="@Icons.Material.Filled.Memory" Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Outlined">
                @Model.HardwareInfo
            </MudChip>
        </MudStack>

        <MudDivider Class="my-2" />

        
        @if (Model.ModelStatusDto == ModelStatusDto.Training)
        {
            <SectionHeading>@Loc.T("LCInfo_TrainingProgress")</SectionHeading>
            <SectionHeading>@Loc.T("LCInfo_CurrentEpoch"): @Model.CurrentEpoch / @Model.TotalEpochs</SectionHeading>
            <MudProgressLinear Value="Model.CurrentEpoch"
                               Max="Model.TotalEpochs"
                               Color="MudBlazor.Color.Primary" />
        }

        @if (Model.ModelStatusDto == ModelStatusDto.Failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
                @Loc.T("LCInfo_TrainingFailed")
            </MudAlert>
        }

        <SectionHeading>@FormatTrainingTime(Model.TrainingTimeInSeconds)</SectionHeading>
        <SectionHeading>@Loc.T("LCInfo_Accuracy"): @(FormatPercent(Model.ValidationAccuracy))</SectionHeading>

        <SectionHeading Class="mt-4">@Loc.T("LCInfo_PerformanceByClass")</SectionHeading>
        <MudSimpleTable Hover="true" Dense="true" Elevation="0" Style="background: transparent;">
            <thead>
                <tr>
                    <th>@Loc.T("LCInfo_ClassByClass")</th>
                    <th>@Loc.T("LCInfo_RecallByClass")</th>
                    <th>@Loc.T("LCInfo_PrecisionByClass")</th>
                    <th>@Loc.T("LCInfo_F1ScoreByClass")</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><b>@Loc.T("LCInfo_MacroAverage")</b></td>
                    <td>@(FormatPercent(Model.MacroRecall))</td>
                    <td>@(FormatPercent(Model.MacroPrecision))</td>
                    <td>@(FormatPercent(Model.MacroF1Score))</td>
                </tr>
                <tr>
                    <td><b>@Loc.T("LCInfo_MacroWeighted")</b></td>
                    <td>@(FormatPercent(Model.WeightedRecall))</td>
                    <td>@(FormatPercent(Model.WeightedPrecision))</td>
                    <td>@(FormatPercent(Model.WeightedF1Score))</td>
                </tr>
                <tr>
                    <td>@Loc.T("LCInfo_NormalClass")</td>
                    <td>@(FormatPercent(Model.NormalRecall))</td>
                    <td>@(FormatPercent(Model.NormalPrecision))</td>
                    <td>@(FormatPercent(Model.NormalF1Score))</td>
                </tr>
                <tr>
                    <td>@Loc.T("LCInfo_BenignClass")</td>
                    <td>@(FormatPercent(Model.BenignRecall))</td>
                    <td>@(FormatPercent(Model.BenignPrecision))</td>
                    <td>@(FormatPercent(Model.BenignF1Score))</td>
                </tr>
                <tr>
                    <td>@Loc.T("LCInfo_MalignantClass")</td>
                    <td>@(FormatPercent(Model.MalignantRecall))</td>
                    <td>@(FormatPercent(Model.MalignantPrecision))</td>
                    <td>@(FormatPercent(Model.MalignantF1Score))</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        <ApexChart TItem="LCRocDto" Title="@Loc.T("LCInfo_RocGraph")" Height="400" Options="options">
            <ApexPointSeries TItem="LCRocDto"
                Items="Model.RocData"
                Name="@Loc.T("LCInfo_RocGraph")"
                SeriesType="SeriesType.Scatter" 
                XValue="@(ed => ed.FalsePositiveRate)"
                YValue="@(ed => (decimal)ed.TruePositiveRate)"
                OrderByDescending="ed=>ed.X"/>
        </ApexChart>
    </MudStack>
}

@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public EventCallback Close { get; set; }

    public LCInfoDto? Model { get; set; }

    private PeriodicTimer? _timer;

    private CancellationTokenSource? _cts;

    private ApexChartOptions<LCRocDto> options = new()
    {
        Xaxis = new XAxis
        {
            Type = XAxisType.Numeric,
            Min = 0,
            Max = 1
        },
        Yaxis = [new YAxis { Min = 0, Max = 1 }]
    };

    public async Task ShowModelDetails(int id)
    {
        if (id == 0)
        {
            await Close.InvokeAsync();
            return;
        }

        var result = await CSharpLCApi.GetModelInfoAsync(id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(Loc.T("LCInfo_Error"), Severity.Error);
            await Close.InvokeAsync();
            return;
        }

        Model = result.Data;
        StateHasChanged();

        if (Model!.ModelStatusDto == ModelStatusDto.Training)
        {
            StartPolling(id);
        }
    }

    private void StartPolling(int id)
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

        _ = PollLoop(id, _cts.Token);
    }

    private async Task PollLoop(int id, CancellationToken ct)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(ct))
            {
                var result = await CSharpLCApi.GetModelInfoAsync(id);
                if (!result.IsSuccess) continue;

                Model = result.Data;

                await InvokeAsync(StateHasChanged);

                if (Model!.ModelStatusDto != ModelStatusDto.Training)
                {
                    _timer.Dispose();

                    if (Model.ModelStatusDto == ModelStatusDto.Trained)
                    {
                        Snackbar.Add(Loc.T("LCInfo_TrainingComplete"), Severity.Success);
                    }
                    else if (Model.ModelStatusDto == ModelStatusDto.Failed)
                    {
                        Snackbar.Add(Loc.T("LCInfo_TrainingFailed"), Severity.Error);
                    }

                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private string FormatPercent(double? value)
    {
        return value.HasValue ? $"{Math.Round(value.Value * 100, 2)}%" : "-";
    }

    private string FormatTrainingTime(double trainingTimeInSeconds)
    {
        if (trainingTimeInSeconds < 60)
        {
            return $"{Loc.T("LCInfo_TrainingTime")}: {Math.Round(trainingTimeInSeconds, 2)} {Loc.T("LCInfo_Seconds")}";
        }
        else
        {
            return $"{Loc.T("LCInfo_TrainingTime")}: {Math.Round(trainingTimeInSeconds/60, 2)} {Loc.T("LCInfo_Minutes")}";
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
    }
}
