@using System.Globalization
@using ApexCharts
@using MudBlazor
@using OmarDesignSystem
@using SharedCL
@using WebApp.LungCancerPrediction.ApiClients
@inject ISnackbar Snackbar
@inject CSharpLCApiClient CSharpLCApi
@implements IDisposable

@if (Model != null)
{
    <MudStack Spacing="4" Class="pa-4">

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <SubHeading Class="mb-0">@Loc.T("LCInfo_Title")</SubHeading>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Color="MudBlazor.Color.Default"
                           OnClick="@(async () => await Close.InvokeAsync())" />
        </MudStack>


        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudChip T="string" Color="@(Model.Language == ModelLanguageDto.CSharp ? MudBlazor.Color.Primary : MudBlazor.Color.Secondary)" Size="MudBlazor.Size.Small">
                @Model.Language
            </MudChip>
            <MudChip T="string" Icon="@Icons.Material.Filled.Autorenew" Size="MudBlazor.Size.Small">
                @Model.TotalEpochs @Loc.T("LCInfo_Epochs")
            </MudChip>
            <MudChip T="string" Icon="@Icons.Material.Filled.Memory" Size="MudBlazor.Size.Small" Variant="MudBlazor.Variant.Outlined">
                @Model.HardwareInfo
            </MudChip>
        </MudStack>

        <MudDivider Class="my-2" />

        
        @if (Model.ModelStatusDto == TrainingStatusDto.Training)
        {
            <SectionHeading>@Loc.T("LCInfo_TrainingProgress")</SectionHeading>
            <SectionHeading>@Loc.T("LCInfo_CurrentEpoch"): @Model.CurrentEpoch / @Model.TotalEpochs</SectionHeading>
            <MudProgressLinear Value="Model.CurrentEpoch"
                               Max="Model.TotalEpochs"
                               Color="MudBlazor.Color.Primary" />
        }

        @if (Model.ModelStatusDto == TrainingStatusDto.Failed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">
                @Loc.T("LCInfo_TrainingFailed")
            </MudAlert>
        }

        <SectionHeading>@FormatTrainingTime(Model.TrainingTimeInSeconds)</SectionHeading>
        <SectionHeading>@Loc.T("LCInfo_Accuracy"): @(FormatPercent(Model.ValidationAccuracy))</SectionHeading>

        <MudDivider Class="my-2" />

        <SectionHeading>@Loc.T("LCInfo_PerformanceByClass")</SectionHeading>
        <MudSimpleTable Hover="true" Dense="true" Elevation="0" Style="background: transparent;">
            <thead>
                <tr>
                    <th>@Loc.T("LCInfo_ClassByClass")</th>
                    <th>@Loc.T("LCInfo_RecallByClass")</th>
                    <th>@Loc.T("LCInfo_PrecisionByClass")</th>
                    <th>@Loc.T("LCInfo_F1ScoreByClass")</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><b>@Loc.T("LCInfo_MacroAverage")</b></td>
                    <td>@(FormatPercent(Model.MacroRecall))</td>
                    <td>@(FormatPercent(Model.MacroPrecision))</td>
                    <td>@(FormatPercent(Model.MacroF1Score))</td>
                </tr>
                <tr>
                    <td><b>@Loc.T("LCInfo_MacroWeighted")</b></td>
                    <td>@(FormatPercent(Model.WeightedRecall))</td>
                    <td>@(FormatPercent(Model.WeightedPrecision))</td>
                    <td>@(FormatPercent(Model.WeightedF1Score))</td>
                </tr>
                <tr>
                    <td>@Loc.T("LCInfo_BenignClass")</td>
                    <td>@(FormatPercent(Model.BenignRecall))</td>
                    <td>@(FormatPercent(Model.BenignPrecision))</td>
                    <td>@(FormatPercent(Model.BenignF1Score))</td>
                </tr>
                <tr>
                    <td>@Loc.T("LCInfo_MalignantClass")</td>
                    <td>@(FormatPercent(Model.MalignantRecall))</td>
                    <td>@(FormatPercent(Model.MalignantPrecision))</td>
                    <td>@(FormatPercent(Model.MalignantF1Score))</td>
                </tr>
                <tr>
                    <td>@Loc.T("LCInfo_NormalClass")</td>
                    <td>@(FormatPercent(Model.NormalRecall))</td>
                    <td>@(FormatPercent(Model.NormalPrecision))</td>
                    <td>@(FormatPercent(Model.NormalF1Score))</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        @if (Model.ModelStatusDto == TrainingStatusDto.Trained)
        {
            <MudDivider Class="my-2" />
            <SectionHeading>@Loc.T("LCInfo_ConfusionMatrix")</SectionHeading>
            <MudSimpleTable Hover="true" Dense="true" Elevation="0" Style="background: transparent;">
                <thead>
                    <tr>
                        <th></th>
                        <th colspan="3" style="text-align:center">@Loc.T("LCInfo_PredictedClass")</th>
                    </tr>
                    <tr>
                        <th>@Loc.T("LCInfo_ActualClass")</th>
                        <th>@Loc.T("LCInfo_BenignClass")</th>
                        <th>@Loc.T("LCInfo_MalignantClass")</th>
                        <th>@Loc.T("LCInfo_NormalClass")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Loc.T("LCInfo_BenignClass")</td>
                        <td>@Model.TrueBenignPredBenign</td>
                        <td>@Model.TrueBenignPredMalignant</td>
                        <td>@Model.TrueBenignPredNormal</td>
                    </tr>
                    <tr>
                        <td>@Loc.T("LCInfo_MalignantClass")</td>
                        <td>@Model.TrueMalignantPredBenign</td>
                        <td>@Model.TrueMalignantPredMalignant</td>
                        <td>@Model.TrueMalignantPredNormal</td>
                    </tr>
                    <tr>
                        <td>@Loc.T("LCInfo_NormalClass")</td>
                        <td>@Model.TrueNormalPredBenign</td>
                        <td>@Model.TrueNormalPredMalignant</td>
                        <td>@Model.TrueNormalPredNormal</td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            <MudDivider Class="my-2" />
            <SectionHeading>@Loc.T("LCInfo_RocAUC")</SectionHeading>
            <SectionHeading>@Loc.T("LCInfo_MacroAUC"): @(FormatPercent(Model.MacroAUC))</SectionHeading>

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="MudBlazor.Color.Default">
                <MudTabPanel Text="Bening ROC AUC">
                    <SectionHeading class="pt-5">@Loc.T("LCInfo_AUC"): @(FormatPercent(Model.BenignAUC))</SectionHeading>
                    <ApexChart @ref="BenignRocChart" TItem="LCRocDto" Height="400" Options="BeningChartOptions">
                        <ApexPointSeries TItem="LCRocDto"
                                         Items="Model.BenignRocData"
                                         Name="@Loc.T("LCInfo_RocGraph")"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(ed => ed.FalsePositiveRate)"
                                         YValue="@(ed => (decimal)ed.TruePositiveRate)" />
                    </ApexChart>
                </MudTabPanel>

                <MudTabPanel Text="Malignant ROC AUC">
                    <SectionHeading class="pt-5">@Loc.T("LCInfo_AUC"): @(FormatPercent(Model.MalignantAUC))</SectionHeading>
                    <ApexChart @ref="MalignantRocChart" TItem="LCRocDto" Height="400" Options="MalignantChartOptions">
                        <ApexPointSeries TItem="LCRocDto"
                                         Items="Model.MalignantRocData"
                                         Name="@Loc.T("LCInfo_RocGraph")"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(ed => ed.FalsePositiveRate)"
                                         YValue="@(ed => (decimal)ed.TruePositiveRate)" />
                    </ApexChart>
                </MudTabPanel>

                <MudTabPanel Text="Normal ROC AUC">
                    <SectionHeading class="pt-5">@Loc.T("LCInfo_AUC"): @(FormatPercent(Model.NormalAUC))</SectionHeading>
                    <ApexChart @ref="NormalRocChart" TItem="LCRocDto" Height="400" Options="NormalChartOptions">
                        <ApexPointSeries TItem="LCRocDto"
                                         Items="Model.NormalRocData"
                                         Name="@Loc.T("LCInfo_RocGraph")"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(ed => ed.FalsePositiveRate)"
                                         YValue="@(ed => (decimal)ed.TruePositiveRate)" />
                    </ApexChart>
                </MudTabPanel>
            </MudTabs>


            
        }
    </MudStack>
}

@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public EventCallback Close { get; set; }

    public LCInfoDto? Model { get; set; }

    private PeriodicTimer? _timer;

    private CancellationTokenSource? _cts;

    private ApexChartOptions<LCRocDto> BeningChartOptions = new();
    private ApexChartOptions<LCRocDto> MalignantChartOptions = new();
    private ApexChartOptions<LCRocDto> NormalChartOptions = new();

    private ApexChart<LCRocDto> BenignRocChart;
    private ApexChart<LCRocDto> MalignantRocChart;
    private ApexChart<LCRocDto> NormalRocChart;

    private void SetOptions()
    {
        BeningChartOptions = GenerateChartOptions(Model!.BenignRocData);
        MalignantChartOptions = GenerateChartOptions(Model!.MalignantRocData);
        NormalChartOptions = GenerateChartOptions(Model!.NormalRocData);
    }

    private ApexChartOptions<LCRocDto> GenerateChartOptions(List<LCRocDto> rocData)
    {
        return new ApexChartOptions<LCRocDto>
        {
            Tooltip = new Tooltip
            {
                Enabled = true,
                Shared = false,
                Intersect = false,
                Custom = new CustomFunction(GenerateJavascriptFunctionForTooltip(rocData))
            },
            Xaxis = new XAxis { Type = XAxisType.Numeric, Min = 0, Max = 1 },
            Yaxis = [new YAxis { Min = 0, Max = 1 }]
        };
    }


    public static string GenerateJavascriptFunctionForTooltip(List<LCRocDto> rocData)
    {
        if (rocData == null || rocData.Count == 0)
        {
            return "function({series, seriesIndex, dataPointIndex, w}) { return '<div>Hello</div>'; }";
        }
        var result = "";
        result += @"function({series, seriesIndex, dataPointIndex, w}) {";
        result += $"const thresholds = [{string.Join(',', rocData.Select(r => r.Threshold.ToString(CultureInfo.InvariantCulture)).ToList())}]; ";
        result += $"const tprLabel = '{Loc.T("LCInfo_TPR")}'; ";
        result += $"const fprLabel = '{Loc.T("LCInfo_FPR")}'; ";
        result += $"const thresholdLabel = '{Loc.T("LCInfo_Threshold")}'; ";
        result += "return `<div>${fprLabel}: ${w.config.series[seriesIndex].data[dataPointIndex].x} </div> <div>${tprLabel}: ${w.config.series[seriesIndex].data[dataPointIndex].y}</div> <div>${thresholdLabel}: ${thresholds[dataPointIndex]}</div>`;";
        result += "}";
        return result;
    }

    public async Task ShowModelDetails(int id)
    {
        if (id == 0)
        {
            await Close.InvokeAsync();
            return;
        }

        var result = await CSharpLCApi.GetModelInfoAsync(id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(Loc.T("LCInfo_Error"), Severity.Error);
            await Close.InvokeAsync();
            return;
        }

        Model = result.Data;
        SetOptions();
        StateHasChanged();
        if (BenignRocChart != null && MalignantRocChart != null && NormalRocChart != null)
        {
            await BenignRocChart.UpdateSeriesAsync();
            await MalignantRocChart.UpdateSeriesAsync();
            await NormalRocChart.UpdateSeriesAsync();
        }

        if (Model!.ModelStatusDto == TrainingStatusDto.Training)
        {
            StartPolling(id);
        }
    }

    private void StartPolling(int id)
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

        _ = PollLoop(id, _cts.Token);
    }

    private async Task PollLoop(int id, CancellationToken ct)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(ct))
            {
                var result = await CSharpLCApi.GetModelInfoAsync(id);
                if (!result.IsSuccess) continue;

                Model = result.Data;

                await InvokeAsync(StateHasChanged);

                if (Model!.ModelStatusDto != TrainingStatusDto.Training)
                {
                    _timer.Dispose();

                    if (Model.ModelStatusDto == TrainingStatusDto.Trained)
                    {
                        Snackbar.Add(Loc.T("LCInfo_TrainingComplete"), Severity.Success);
                    }
                    else if (Model.ModelStatusDto == TrainingStatusDto.Failed)
                    {
                        Snackbar.Add(Loc.T("LCInfo_TrainingFailed"), Severity.Error);
                    }

                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private string FormatPercent(double? value)
    {
        return value.HasValue ? $"{Math.Round(value.Value * 100, 2)}%" : "-";
    }

    private string FormatTrainingTime(double trainingTimeInSeconds)
    {
        return $"{Loc.T("LCInfo_TrainingTime")}: {Math.Round(trainingTimeInSeconds, 2)} {Loc.T("LCInfo_Seconds")}";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
    }
}
