@page "/lungCancer/trainer"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using OmarDesignSystem
@using SharedCL.LungCancerPrediction.Models
@using SharedCL.Shared.Enums
@using SharedCL.Shared.Models
@using WebApp.LungCancerPrediction.ApiClients
@using WebApp.SharedKernel
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject CSharpLungCancerApiClient CSharpLungCancerApi
@inject PythonLungCancerApiClient PythonLungCancerApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Treniranje Modela za Rak Pluća</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mb-16 mt-8">
    
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/lungCancer" Color="Color.Default" />
        <SubHeading Class="mb-0">Treniranje Modela</SubHeading>
    </MudStack>

    <MudCard Elevation="1">
        <MudCardContent Class="pa-6">
            <MudForm @ref="_form">
                <MudStack Spacing="4">
                    <MudTextField @bind-Value="trainingParams.ModelName" 
                                  Required="true"
                                  RequiredError="Naziv modela je obavezan!" 
                                  Variant="Variant.Outlined" 
                                  Label="Naziv modela" />
                                  
                    <MudNumericField @bind-Value="trainingParams.Epochs" 
                                     Required="true" 
                                     RequiredError="Broj epoha je obavezan!" 
                                     Variant="Variant.Outlined" 
                                     Label="Broj epoha" 
                                     Min="1" Max="10" />

                    <MudSelect T="ModelLanguage" 
                               @bind-Value="trainingParams.ModelLanguage" 
                               Label="Jezik modela"
                               Variant="Variant.Outlined" 
                               Required="true" 
                               RequiredError="Model Mašinskog Učenja je obavezan!" 
                               Clearable>
                        @foreach (var item in Enum.GetValues<ModelLanguage>())
                        {
                            <MudSelectItem Value="@item">@item.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                    <MudCheckBox @bind-Value="trainingParams.WithFlips" 
                                 Label="Rotiraj slike (Augmentacija)" 
                                 Color="Color.Primary" />
                </MudStack>
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="pa-6 pt-0">
            <MudStack Row Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.End" Style="width: 100%;">
                
                @if (model != null)
                {
                    <MudButton OnClick="ShowModelDetails" Color="@Color.Default" Variant="@Variant.Outlined">
                        Prikaži Rezultate
                    </MudButton>
                }
                <LoadingButton Color="@Color.Primary"
                               Variant="@Variant.Filled"
                               OnClick="TrainModel"
                               LoadingText="Treniranje...">
                    Treniraj
                </LoadingButton>
            </MudStack>
        </MudCardActions>
    </MudCard>
</MudContainer>


@code {

    private MudForm _form = null!;
    private LungCancerTrainingParams trainingParams;

    private LungCancerModel? model;


    protected override void OnInitialized()
    {
        trainingParams = new LungCancerTrainingParams()
        {
            ModelName = $"RakPlucaModel_{DateTime.Now:yyyyMMdd_HHmmss}",
            Epochs = 5,
            ModelLanguage = ModelLanguage.CSharp
        };

        base.OnInitialized();
    }

    private async Task TrainModel()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        Result<LungCancerModel> result;
        if (trainingParams.ModelLanguage == ModelLanguage.CSharp)
        {
            result = await CSharpLungCancerApi.TrainModelAsync(trainingParams);
        }
        else
        {
            result = await PythonLungCancerApi.TrainModelAsync(trainingParams);
        }

        if (result.IsSuccess)
        {
            model = result.Data!;
            await ShowModelDetails();
            Snackbar.Add("Model je uspešno treniran!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Greška prilikom treniranja modela.", Severity.Error);
        }
    }

    private async Task ShowModelDetails()
    {
        var parameters = new DialogParameters<LungCancerInfoDialog>
        {
            { x => x.Model, model },
            { x => x.ShowSaveOption, true }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
        await DialogService.ShowAsync<LungCancerInfoDialog>("Detalji Modela", parameters, options);
    }
}
