@page "/inference"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using System.Globalization
@using OmarDesignSystem
@using SharedCL
@using WebApp.LungCancerPrediction.ApiClients
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Forms
@inject CSharpLCApiClient CSharpApi
@inject PythonLCApiClient PythonApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>@Loc.T("LCInference_PageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mb-16 mt-8">
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <PageTop Title="@Loc.T("LCInference_Title")"></PageTop>
        </MudItem>
        <MudItem xs="12">
            <MudCard Elevation="1">
                <MudCardContent Class="pa-6">
                    <MudForm @ref="_form">
                        <MudStack Spacing="4">
                            <MudPaper Outlined="true" Elevation="0" Class="pa-4" Style="border: 2px dashed var(--mud-palette-lines-default); background-color: transparent;">
                                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                            
                                    @if (!string.IsNullOrWhiteSpace(_base64))
                                    {
                                        <MudImage Src="@_base64" Alt="CT Scan Preview" Height="180" Elevation="2" Class="rounded-lg" ObjectFit="ObjectFit.Cover" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" Style="opacity: 0.5;" />
                                        <BodyText>@Loc.T("LCInference_Description")</BodyText>
                                    }

                                    <MudFileUpload T="IBrowserFile" @bind-Files="_file" @bind-Files:after="UploadImage"
                                                   Required="true" RequiredError="@Loc.T("LCInference_ImageRequired")"
                                                   Accept=".png,.jpg,.jpeg">
                                        <CustomContent>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       OnClick="@context.OpenFilePickerAsync"
                                                       StartIcon="@Icons.Material.Filled.CloudUpload">
                                                @(_file == null ? @Loc.T("LCInference_BrowseFiles") : @Loc.T("LCInference_ChangeImage"))
                                            </MudButton>
                                        </CustomContent>
                                    </MudFileUpload>
                                </MudStack>
                            </MudPaper>

                            <MudSelect T="LCBasicDto" Label="@Loc.T("LCInference_ModelSelect")" @bind-Value="SelectedModel"
                                       Required="true" RequiredError="@Loc.T("LCInference_ModelRequired")" Clearable="true" Variant="Variant.Outlined">
                                @foreach (var item in Models)
                                {
                                    <MudSelectItem Value="@item">@item.Name</MudSelectItem>
                                }
                            </MudSelect>

                            @if (Prediction != null)
                            {
                                <MudStack Row="false" AlignItems="AlignItems.Center">

                                    <MudAlert Variant="Variant.Filled" Dense="true" Severity="@GetPredictionSeverity(Prediction.PredictionType)" Class="mt-2">
                                        <b>@Loc.T("LCInference_Result"): @GetPredictionLabel(Prediction.PredictionType) (@Loc.T("LCInference_Confidance"): @(Prediction.PredictionScore)%)</b>
                                    </MudAlert>
                                    <MudChip T="string" Icon="@Icons.Material.Filled.Timer" Size="Size.Small">
                                        @Math.Round(Prediction.PredictionTimeInSeconds, 2) @Loc.T("LCInference_PredictionTime")
                                    </MudChip>
                                </MudStack>
                            }
                    
                        </MudStack>
                    </MudForm>
                </MudCardContent>

                <MudCardActions Class="pa-6 pt-0" Style="justify-content: center;">
                    <LoadingButton Color="@Color.Primary"
                                   Variant="@Variant.Filled"
                                   OnClick="Predict"
                                   LoadingText="@Loc.T("LCInference_LoadingText")">
                        @Loc.T("LCInference_AnalyzeImage")
                    </LoadingButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>


@code {

    private MudForm _form = null!;
    private IBrowserFile? _file = null;
    private string _base64 = string.Empty;

    private List<LCBasicDto> Models { get; set; } = new List<LCBasicDto>();
    private LCBasicDto SelectedModel = null!;

    private LCPredictionDto? Prediction = null;

    protected override async Task OnInitializedAsync()
    {
        var result = await CSharpApi.GetModelsBasicAsync();
        if (result.IsSuccess)
        {
            Models = result.Data!;
        }
        else
        {
            Snackbar.Add(@Loc.T("LCInference_ModelLoadingError"), Severity.Error);
        }
        await base.OnInitializedAsync();
    }

    private async Task Predict()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            StateHasChanged();
            return;
        }

        Result<LCPredictionDto> predResult;
        if(SelectedModel.Language == ModelLanguageDto.CSharp)
        {
            predResult = await CSharpApi.PredictAsync(SelectedModel.Id, _file);
        }
        else
        {
            predResult = await PythonApiClient.PredictAsync(SelectedModel.Name, _file);
        }

        if (predResult.IsSuccess)
        {
            Prediction = predResult.Data!;
        }
        else
        {
            Snackbar.Add(@Loc.T("LCInference_AnalysisError"), Severity.Error);
        }
    }

    private async Task UploadImage()
    {
        if (_file == null)
        {
            _base64 = string.Empty;
            StateHasChanged();
            return;
        }
        if (_file.Size > 5242880)
        {
            Snackbar.Add(@Loc.T("LCInference_FileSizeError"), Severity.Error);
            return;
        }

        using var stream = _file.OpenReadStream(5242880);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        var fileBytes = memoryStream.ToArray();

        _base64 = $"data:{_file.ContentType};base64,{Convert.ToBase64String(fileBytes)}";

    }


    private Severity GetPredictionSeverity(PredictionTypeDto prediction)
    {
        if (prediction == PredictionTypeDto.Benign)
        {
            return Severity.Success;
        }
        else if (prediction == PredictionTypeDto.Malignant)
        {
            return Severity.Error;
        }
        else
        {
            return Severity.Info;
        }
    }

    private string GetPredictionLabel(PredictionTypeDto prediction)
    {
        if (prediction == PredictionTypeDto.Benign)
        {
            return Loc.T("LCInference_Benign");
        }
        else if (prediction == PredictionTypeDto.Malignant)
        {
            return Loc.T("LCInference_Malignant");
        }
        else
        {
            return Loc.T("LCInference_Normal");
        }
    }
}
