@page "/lungCancer/models"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using OmarDesignSystem
@using SharedCL.LungCancerPrediction.Dtos
@using SharedCL.LungCancerPrediction.Models
@using SharedCL.Shared.Enums
@using SharedCL.Shared.Models
@using WebApp.LungCancerPrediction.ApiClients
@using WebApp.Shared.Components
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject CSharpLungCancerApiClient LungCancerApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Pregled Modela</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    
    <MudGrid>
        <MudItem xs="12">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/lungCancer" Color="Color.Default" />
                <MainHeading Class="mb-0">Pregled Modela</MainHeading>
            </MudStack>
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="SearchString"
                          Placeholder="Pretraži modele..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Variant="Variant.Outlined"
                          Immediate="true" />
        </MudItem>
        <MudItem xs="12">
            <MudDataGrid @ref="@DataGrid" T="LCDto" Hover Filterable="false" Striped ServerData="ServerReload" FixedHeader FixedFooter>
                <NoRecordsContent>
                    @if (!string.IsNullOrWhiteSpace(SearchString))
                    {
                        <NoRecords Title="Modeli nisu pronađeni"
                                   Message="Promjenite filtere za prikaz modela" Filtered />
                    }
                    else
                    {
                        <NoRecords Title="Modeli nisu pronađeni"
                                   Message="Trenirajte prvi model da možete početi raditi analizu" />
                    }
                </NoRecordsContent>
                <Columns>
                    <PropertyColumn Property="x => x.Name" Title="Naziv" Sortable="true" />
                    <PropertyColumn Property="x => x.Language" Title="Jezik" Sortable="true" />
                    <PropertyColumn Property="x => x.MacroRecall" Title="Odziv" Format="P2" Sortable="true" />
                    <PropertyColumn Property="x => x.MacroPrecision" Title="Preciznost" Format="P2" Sortable="true" />
                    <PropertyColumn Property="x => x.MacroF1Score" Title="F1" Format="P2" Sortable="true" />
                    <TemplateColumn Title="" Sortable="false" Filterable="false">
                        <CellTemplate>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight"
                                     Size="Size.Small"
                                     Dense="true">
                                <MudMenuItem OnClick="@(() => ShowModelDetails(context.Item))" Icon="@Icons.Material.Filled.Info">
                                    Detalji
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => ConfirmDelete(context.Item))" Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error">
                                    Obriši
                                </MudMenuItem>
                            </MudMenu>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="LCDto" />
                </PagerContent>
            </MudDataGrid>
        </MudItem>
    </MudGrid>

    
</MudContainer>

@code {
    private MudDataGrid<LCDto> DataGrid = null!;

    private List<LCDto> _models = [];

    private int NumberOfModels = -1;

    private SortDefinition<LCDto>? CurrentSort;

    private string _search = string.Empty;

    private string SearchString
    {
        get
        {
            return _search;
        }
        set
        {
            _search = value;
            DataGrid.ReloadServerData();
        }
    }

    private async Task<GridData<LCDto>> ServerReload(GridState<LCDto> state, CancellationToken token)
    {
        var options = new LCModelsGridOptionsDto();
        options.Search = SearchString;
        var sortDefintion = state.SortDefinitions.FirstOrDefault();
        if (sortDefintion != null)
        {
            options.SortBy = sortDefintion.SortBy;
            options.SortDescending = sortDefintion.Descending;
            CurrentSort = sortDefintion;
        }
        options.PageSize = state.PageSize;
        options.CurrentPage = state.Page;
        var result = await LungCancerApi.GetModelsAsync(options);

        if (result.IsSuccess && result.Data is not null)
        {
            return new GridData<LCDto>()
            {
                Items = result.Data.Models,
                TotalItems = result.Data.TotalItems
            };
        }
        else
        {
            Snackbar.Add(result.Message ?? "Error fetching models!", Severity.Error);
        }

        return new GridData<LCDto>()
        {
            Items = new List<LCDto>(),
            TotalItems = 0
        };
    }

