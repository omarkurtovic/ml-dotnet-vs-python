@page "/models"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using OmarDesignSystem
@using SharedCL
@using WebApp.LungCancerPrediction.ApiClients
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject CSharpLCApiClient CSharpLCApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>@Loc.T("LCModels_PageTitle")</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <MudGrid>
        <MudItem xs="12">
            <PageTop Title="@Loc.T("LCModels_Title")"></PageTop>
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="SearchString"
                          Placeholder="@Loc.T("LCModels_Search")"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Variant="Variant.Outlined"
                          Immediate="true" />
        </MudItem>
        <MudItem xs="12">
            <MudDataGrid @ref="@DataGrid" T="LCBasicDto" Hover Filterable="false" Striped ServerData="ServerReload" FixedHeader FixedFooter>
                <NoRecordsContent>
                    @if (!string.IsNullOrWhiteSpace(SearchString))
                    {
                        <NoRecords Title="@Loc.T("LCModels_NoResults")"
                                   Message="@Loc.T("LCModels_ChangeFilters")" Filtered />
                    }
                    else
                    {
                        <NoRecords Title="@Loc.T("LCModels_NoModels")"
                                   Message="@Loc.T("LCModels_NoModels")" />
                    }
                </NoRecordsContent>
                <Columns>
                    <PropertyColumn Property="x => x.Name" Title="@Loc.T("LCModels_Name")" Sortable="true" />
                    <PropertyColumn Property="x => x.Language" Title="@Loc.T("LCModels_Language")" Sortable="true" />
                    <PropertyColumn Property="x => x.MacroRecall" Title="@Loc.T("LCModels_Recall")" Format="P2" Sortable="true" />
                    <PropertyColumn Property="x => x.MacroPrecision" Title="@Loc.T("LCModels_Precision")" Format="P2" Sortable="true" />
                    <PropertyColumn Property="x => x.MacroF1Score" Title="@Loc.T("LCModels_F1Score")" Format="P2" Sortable="true" />
                    <PropertyColumn Property="x => x.Accuracy" Title="@Loc.T("LCModels_Accuracy")" Format="P2" Sortable="true" />
                    <TemplateColumn Title="" Sortable="false" Filterable="false">
                        <CellTemplate>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight"
                                     Size="Size.Small"
                                     Dense="true">
                                <MudMenuItem OnClick="@(() => ShowModelDetails(context.Item))" Icon="@Icons.Material.Filled.Info">
                                    @Loc.T("LCModels_Details")
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => ShowModelEdit(context.Item))" Icon="@Icons.Material.Filled.Edit">
                                    @Loc.T("LCModels_Edit")
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => ConfirmDelete(context.Item))" Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error">
                                    @Loc.T("LCModels_Delete")
                                </MudMenuItem>
                            </MudMenu>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="LCBasicDto" />
                </PagerContent>
            </MudDataGrid>
        </MudItem>
    </MudGrid>
</MudContainer>

<MudDrawer @bind-Open="@IsSideDrawerOpen"
           Fixed="true"
           Anchor="Anchor.End"
           Variant="@DrawerVariant.Temporary"
           Width="min(100vw, 600px)"
           Elevation="2">
    <div class="px-6 mt-6">
        @if (_drawerShown == DrawerShown.Info)
        {
            <LCInfo @ref="LCInfo" Close="CloseDrawer"></LCInfo>
        }
        else if(_drawerShown == DrawerShown.Edit)
        {
            <LCEdit @ref="LCEdit" Close="CloseDrawer" RefreshMainGrid="(async () => await DataGrid.ReloadServerData())"></LCEdit>
        }
    </div>
</MudDrawer>

@code {
    private MudDataGrid<LCBasicDto> DataGrid = null!;

    private string search = string.Empty;

    private string SearchString
    {
        get
        {
            return search;
        }
        set
        {
            search = value;
            DataGrid.ReloadServerData();
        }
    }

    private bool IsSideDrawerOpen = false;
    private DrawerShown _drawerShown = DrawerShown.Info;

    private void CloseDrawer() => IsSideDrawerOpen = false;

    private LCInfo LCInfo = null!;

    private LCEdit LCEdit = null!;


    private enum DrawerShown
    {
        Info,
        Edit
    }

    private async Task<GridData<LCBasicDto>> ServerReload(GridState<LCBasicDto> state, CancellationToken token)
    {
        var options = new LCGridOptionsDto();
        options.Search = SearchString;
        var sortDefintion = state.SortDefinitions.FirstOrDefault();
        if (sortDefintion != null)
        {
            options.SortBy = sortDefintion.SortBy;
            options.SortDescending = sortDefintion.Descending;
        }
        options.PageSize = state.PageSize;
        options.CurrentPage = state.Page;
        var result = await CSharpLCApi.GetModelsSearchAsync(options);

        if (result.IsSuccess && result.Data is not null)
        {
            return new GridData<LCBasicDto>()
            {
                Items = result.Data.Models,
                TotalItems = result.Data.TotalItems
            };
        }
        else
        {
            Snackbar.Add(Loc.T("LCModels_Error"), Severity.Error);
        }

        return new GridData<LCBasicDto>()
        {
            Items = new List<LCBasicDto>(),
            TotalItems = 0
        };
    }

    private async Task ShowModelDetails(LCBasicDto model)
    {
        _drawerShown = DrawerShown.Info;
        StateHasChanged();
        await LCInfo.ShowModelDetails(model.Id);
        IsSideDrawerOpen = true;

    }

    private async Task ConfirmDelete(LCBasicDto model)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.Message, Loc.T("LCModels_ConfirmDelete") },
            { x => x.OnDelete, async () =>
                {
                    Result apiResult = await CSharpLCApi.DeleteModelAsync(model.Id);
                    if (!apiResult.IsSuccess)
                    {
                        Snackbar.Add(Loc.T("LCModels_DeleteError"), Severity.Error);
                    }

                    return apiResult.IsSuccess;
                }
            }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirm", parameters);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            bool isSuccess = (bool)dialogResult.Data!;

            if (isSuccess)
            {
                Snackbar.Add(Loc.T("LCModels_DeleteSuccess"), Severity.Success);
                await DataGrid.ReloadServerData();
            }
        }
    }


    private async Task ShowModelEdit(LCBasicDto model)
    {
        _drawerShown = DrawerShown.Edit;
        StateHasChanged();
        await LCEdit.EditModelAsync(model.Id);
        IsSideDrawerOpen = true;
    }
}

