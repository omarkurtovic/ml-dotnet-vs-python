@page "/trainer"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using OmarDesignSystem
@using SharedCL
@using WebApp.LungCancerPrediction.ApiClients
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject CSharpLCApiClient CSharpLCApi
@inject PythonLCApiClient PythonLCApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Treniranje Modela za Rak Pluća</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-16">
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <PageTop Title="Treniranje Modela"></PageTop>
        </MudItem>

        <MudItem xs="12">
            <MudCard Elevation="1">
                <MudCardContent Class="pa-6">
                    <MudForm @ref="Form">
                        <MudStack Spacing="4">
                            <MudTextField @bind-Value="TrainingParams.Name"
                                          Required="true"
                                          RequiredError="Naziv modela je obavezan!"
                                          Variant="Variant.Outlined"
                                          Label="Naziv modela" />
                                  
                            <MudNumericField @bind-Value="TrainingParams.Epochs"
                                             Required="true"
                                             RequiredError="Broj epoha je obavezan!"
                                             Variant="Variant.Outlined"
                                             Label="Broj epoha"
                                             Min="1" Max="10" />

                            <MudSelect T="ModelLanguageDto"
                                       @bind-Value="TrainingParams.Language"
                                       Label="Jezik modela"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       RequiredError="Model Mašinskog Učenja je obavezan!"
                                       Clearable>
                                @foreach (var item in Enum.GetValues<ModelLanguageDto>())
                                {
                                    <MudSelectItem Value="@item">@item.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                            <MudCheckBox @bind-Value="TrainingParams.WithFlips"
                                         Label="Rotiraj slike (Augmentacija)"
                                         Color="Color.Primary" />
                        </MudStack>
                    </MudForm>
                </MudCardContent>
                <MudCardActions Class="pa-6 pt-0">
                    <MudStack Row Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.End" Style="width: 100%;">
                        @if (ModelId != null)
                        {
                            <MudButton OnClick="ShowModelDetails" Color="@Color.Default" Variant="@Variant.Outlined">
                                Prikaži Rezultate
                            </MudButton>
                        }
                        <LoadingButton Color="@Color.Primary"
                                       Variant="@Variant.Filled"
                                       OnClick="TrainModel"
                                       LoadingText="Treniranje...">
                            Treniraj
                        </LoadingButton>
                    </MudStack>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
    

    
</MudContainer>

<MudDrawer @bind-Open="@IsSideDrawerOpen"
           Fixed="true"
           Anchor="Anchor.End"
           Variant="@DrawerVariant.Temporary"
           Width="min(100vw, 600px)"
           Elevation="2">
    <div class="px-6 mt-6">
        <LCInfo @ref="LCInfo" Close="CloseDrawer"></LCInfo>
    </div>
</MudDrawer>

@code {

    private MudForm Form = null!;

    private LCTrainingParamsDto TrainingParams = new();

    private int? ModelId { get; set; } = null;

    private bool IsSideDrawerOpen = false;

    private void CloseDrawer() => IsSideDrawerOpen = false;

    private LCInfo LCInfo = null!;

    protected override void OnInitialized()
    {
        TrainingParams = new LCTrainingParamsDto()
        {
            Name = $"RakPlucaModel_{DateTime.Now:yyyyMMdd_HHmmss}",
            Epochs = 5,
            Language = ModelLanguageDto.CSharp
        };

        base.OnInitialized();
    }

    private async Task TrainModel()
    {
        await Form.ValidateAsync();
        if (!Form.IsValid)
            return;


        if (TrainingParams.Language == ModelLanguageDto.CSharp)
        {
            await TrainCSharpModel();
        }
        else
        {
            await TrainPythonModel();
        }

    }

    private async Task TrainPythonModel()
    {
        var trainingResult = await PythonLCApi.TrainModelAsync(TrainingParams);
        if (!trainingResult.IsSuccess)
        {
            Snackbar.Add("Greška prilikom treniranja modela.", Severity.Error);
            return;
        }

        var modelDto = trainingResult.Data!;
        var saveResult = await CSharpLCApi.SaveModelAsync(modelDto);
        if (!saveResult.IsSuccess)
        {
            Snackbar.Add("Model je treniran, ali došlo je do greške prilikom spremanja modela.", Severity.Error);
            return;
        }

        Snackbar.Add("Model je uspešno treniran i spremljen!", Severity.Success);
        ModelId = saveResult.Data;
        await ShowModelDetails();
    }

    private async Task TrainCSharpModel()
    {
        var result = await CSharpLCApi.TrainModelAsync(TrainingParams);
        if (!result.IsSuccess)
        {
            Snackbar.Add("Greška prilikom treniranja modela.", Severity.Error);
            return;
        }

        Snackbar.Add("Model je uspešno treniran i spremljen!", Severity.Success);
        ModelId = result.Data;
        await ShowModelDetails();
    }

    private async Task ShowModelDetails()
    {
        if(ModelId == null)
        {
            return;
        }

        await LCInfo.ShowModelDetails((int)ModelId);
        IsSideDrawerOpen = true;
    }
}
