@page "/lungCancer/trainer"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using OmarDesignSystem
@using SharedCL
@using WebApp.LungCancerPrediction.ApiClients
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject CSharpLCApiClient CSharpLCApi
@inject PythonLCApiClient PythonLCApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Treniranje Modela za Rak Pluća</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mb-16 mt-8">
    
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/lungCancer" Color="Color.Default" />
        <SubHeading Class="mb-0">Treniranje Modela</SubHeading>
    </MudStack>

    <MudCard Elevation="1">
        <MudCardContent Class="pa-6">
            <MudForm @ref="Form">
                <MudStack Spacing="4">
                    <MudTextField @bind-Value="TrainingParams.Name" 
                                  Required="true"
                                  RequiredError="Naziv modela je obavezan!" 
                                  Variant="Variant.Outlined" 
                                  Label="Naziv modela" />
                                  
                    <MudNumericField @bind-Value="TrainingParams.Epochs" 
                                     Required="true" 
                                     RequiredError="Broj epoha je obavezan!" 
                                     Variant="Variant.Outlined" 
                                     Label="Broj epoha" 
                                     Min="1" Max="10" />

                    <MudSelect T="ModelLanguageDto" 
                               @bind-Value="TrainingParams.Language" 
                               Label="Jezik modela"
                               Variant="Variant.Outlined" 
                               Required="true" 
                               RequiredError="Model Mašinskog Učenja je obavezan!" 
                               Clearable>
                        @foreach (var item in Enum.GetValues<ModelLanguage>())
                        {
                            <MudSelectItem Value="@item">@item.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                    <MudCheckBox @bind-Value="TrainingParams.WithFlips" 
                                 Label="Rotiraj slike (Augmentacija)" 
                                 Color="Color.Primary" />
                </MudStack>
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="pa-6 pt-0">
            <MudStack Row Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.End" Style="width: 100%;">
                @if (Model != null)
                {
                    <MudButton OnClick="ShowModelDetails" Color="@Color.Default" Variant="@Variant.Outlined">
                        Prikaži Rezultate
                    </MudButton>
                }
                <LoadingButton Color="@Color.Primary"
                               Variant="@Variant.Filled"
                               OnClick="TrainModel"
                               LoadingText="Treniranje...">
                    Treniraj
                </LoadingButton>
            </MudStack>
        </MudCardActions>
    </MudCard>
</MudContainer>

<MudDrawer @bind-Open="@IsSideDrawerOpen"
           Fixed="true"
           Anchor="Anchor.End"
           Variant="@DrawerVariant.Temporary"
           Width="min(100vw, 600px)"
           Elevation="2">
    <div class="px-6 mt-6">
        <LCInfo @ref="LCInfo" Close="CloseDrawer"></LCInfo>
    </div>
</MudDrawer>

@code {

    private MudForm Form = null!;

    private TrainingParamsDto TrainingParams = new();

    private LCDto Model { get; set; } = null!;

    private bool IsSideDrawerOpen = false;

    private void CloseDrawer() => IsSideDrawerOpen = false;

    private LCInfo LCInfo = null!;

    protected override void OnInitialized()
    {
        TrainingParams = new TrainingParamsDto()
        {
            Name = $"RakPlucaModel_{DateTime.Now:yyyyMMdd_HHmmss}",
            Epochs = 5,
            Language = ModelLanguageDto.CSharp
        };

        base.OnInitialized();
    }

    private async Task TrainModel()
    {
        await Form.ValidateAsync();
        if (!Form.IsValid)
            return;

        Result<LCDto> result;
        if (TrainingParams.Language == ModelLanguageDto.CSharp)
        {
            result = await CSharpLCApi.TrainModelAsync(TrainingParams);
        }
        else
        {
            result = await PythonLCApi.TrainModelAsync(TrainingParams);
        }

        if (result.IsSuccess)
        {
            Snackbar.Add("Model je uspešno treniran!", Severity.Success);
            Model = result.Data!;
            await ShowModelDetails();
        }
        else
        {
            Snackbar.Add("Greška prilikom treniranja modela.", Severity.Error);
        }
    }

    private async Task ShowModelDetails()
    {
        await LCInfo.ShowModelDetails(Model.Id);
        IsSideDrawerOpen = true;
    }
}
