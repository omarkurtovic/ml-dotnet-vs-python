@page "/"
@using MudBlazor
@using OmarDesignSystem 
@using Microsoft.Extensions.Localization

<MudContainer MaxWidth="MaxWidth.Large" Class="mb-16 mt-8">
    
    <MudStack AlignItems="AlignItems.Center" Class="mb-12">
        <MainHeading>@Loc.T("LCHome_Title")</MainHeading>
        <BodyText Style="max-width: 700px;">
            @Loc.T("LCHome_Description")
        </BodyText>
    </MudStack>

    <MudGrid Spacing="4" Class="mb-8">
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Style="height: 100%;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Large">
                            <MudIcon Icon="@Icons.Material.Filled.ModelTraining" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <SectionHeading>@Loc.T("LCHome_TrainModel")</SectionHeading>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <BodyText>
                        @Loc.T("LCHome_TrainModelDescription")
                    </BodyText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/trainer" Variant="Variant.Filled" Color="Color.Primary" Class="mb-2">
                        @Loc.T("LCHome_TrainModelAction")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Style="height: 100%;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Large">
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <SectionHeading>@Loc.T("LCHome_RunAnalysis")</SectionHeading>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <BodyText>
                        @Loc.T("LCHome_RunAnalysisDescription")
                    </BodyText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/inference" Variant="Variant.Filled" Color="Color.Primary" Class="mb-2">
                        @Loc.T("LCHome_RunAnalysisAction")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="6">
            <MudCard Elevation="1" Style="height: 100%;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.List" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <SectionHeading>@Loc.T("LCHome_ReviewModels")</SectionHeading>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <BodyText>
                        @Loc.T("LCHome_ReviewModelsDescription")
                    </BodyText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/models" Variant="Variant.Outlined" Color="Color.Primary" Class="mb-2">
                        @Loc.T("LCHome_ReviewModelsAction")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Elevation="1" Style="height: 100%;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.StackedLineChart" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <SectionHeading>@Loc.T("LCHome_Comparison")</SectionHeading>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <BodyText>
                        @Loc.T("LCHome_ComparisonDescription")
                    </BodyText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/comparison" Variant="Variant.Outlined" Color="Color.Primary" Class="mb-2">
                        @Loc.T("LCHome_ComparisonAction")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

</MudContainer>