@using MudBlazor
@using SharedCL.LungCancerPrediction.Models
@using WebApp.LungCancerPrediction.ApiClients
@inject ISnackbar Snackbar
@inject CSharpLungCancerApiClient LungCancerApi

<MudDialog>
    <TitleContent>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-2" />
            <MudText Typo="Typo.h6">Performanse Modela: @Model.Name</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (Model != null)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1">Jezik: @Model.Language</MudText>
                    <MudText Typo="Typo.subtitle1" Class="mb-3">Vrijeme Treniranja: @(Model.TrainingTimeInSeconds) sekundi</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Trening / Validacija</b></MudText>
                    <MudSimpleTable Hover="true" Dense="true">
                        <tbody>
                            <tr><td>Preciznost (Trening)</td><td>@(LastEpochData.TrainingAccuracy == null ? "" : Math.Round(LastEpochData.TrainingAccuracy.Value * 100, 2))%</td></tr>
                            <tr><td>Preciznost (Validacija)</td><td>@(LastEpochData.ValidationAccuracy == null ? "" : Math.Round(LastEpochData.ValidationAccuracy.Value * 100, 2))%</td></tr>
                            <tr><td>Gubitak (Validacija)</td><td>@(LastEpochData.ValidationLoss == null ? "" : Math.Round(LastEpochData.ValidationLoss.Value, 4).ToString())</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Benigno</b></MudText>
                    <MudSimpleTable Hover="true" Dense="true">
                        <tbody>
                            <tr><td>Preciznost</td><td>@(LastEpochData.BenignPrecision == null ? "" : Math.Round(LastEpochData.BenignPrecision.Value * 100, 2))%</td></tr>
                            <tr><td>Recall</td><td>@(LastEpochData.BenignRecall == null ? "" : Math.Round(LastEpochData.BenignRecall.Value * 100, 2))%</td></tr>
                            <tr><td>F1 Score</td><td>@(LastEpochData.BenignF1Score == null ? "" : Math.Round(LastEpochData.BenignF1Score.Value * 100, 2))%</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Maligno</b></MudText>
                    <MudSimpleTable Hover="true" Dense="true">
                        <tbody>
                            <tr><td>Preciznost</td><td>@(LastEpochData.MalignantPrecision == null ? "" : Math.Round(LastEpochData.MalignantPrecision.Value * 100, 2))%</td></tr>
                            <tr><td>Recall</td><td>@(LastEpochData.MalignantRecall == null ? "" : Math.Round(LastEpochData.MalignantRecall.Value * 100, 2))%</td></tr>
                            <tr><td>F1 Score</td><td>@(LastEpochData.MalignantF1Score == null ? "" : Math.Round(LastEpochData.MalignantF1Score.Value * 100, 2))%</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Normalno</b></MudText>
                    <MudSimpleTable Hover="true" Dense="true">
                        <tbody>
                            <tr><td>Preciznost</td><td>@(LastEpochData.NormalPrecision == null ? "" : Math.Round(LastEpochData.NormalPrecision.Value * 100, 2))%</td></tr>
                            <tr><td>Recall</td><td>@(LastEpochData.NormalRecall == null ? "" : Math.Round(LastEpochData.NormalRecall.Value * 100, 2))%</td></tr>
                            <tr><td>F1 Score</td><td>@(LastEpochData.NormalF1Score == null ? "" : Math.Round(LastEpochData.NormalF1Score.Value * 100, 2))%</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Makro Prosjek</b></MudText>
                    <MudSimpleTable Hover="true" Dense="true">
                        <tbody>
                            <tr><td>Preciznost</td><td>@(LastEpochData.MacroPrecision == null ? "" : Math.Round(LastEpochData.MacroPrecision.Value * 100, 2))%</td></tr>
                            <tr><td>Recall</td><td>@(LastEpochData.MacroRecall == null ? "" : Math.Round(LastEpochData.MacroRecall.Value * 100, 2))%</td></tr>
                            <tr><td>F1 Score</td><td>@(LastEpochData.MacroF1Score == null ? "" : Math.Round(LastEpochData.MacroF1Score.Value * 100, 2))%</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        @if (ShowSaveOption)
        {
            <MudButton OnClick="@Save" Color="Color.Primary" Variant="Variant.Filled">Sačuvaj</MudButton>
        }
        <MudButton OnClick="@(() => MudDialog.Close())" Color="Color.Primary" Variant="Variant.Outlined">Zatvori</MudButton>
    </DialogActions>
</MudDialog>


@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public LungCancerModel Model { get; set; } = null!;
    [Parameter] public bool ShowSaveOption { get; set; } = false;

    private LungCancerModelEpochData LastEpochData = null!;

    protected override Task OnInitializedAsync()
    {
        LastEpochData = Model.EpochData.MaxBy(x => x.Epoch)!;
        return base.OnInitializedAsync();
    }

    private async Task Save()
    {
        var result = await LungCancerApi.SaveModelAsync(Model);
        if (result.IsSuccess)
        {
            Snackbar.Add("Model sačuvan!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Greška prilikom sačuvanja modela!", Severity.Error);
        }
    }
}
